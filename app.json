{
  "expo": {
    "name": "WG Clean",
    "slug": "wg-clean",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "wgclean",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/app-icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.wgclean",
      "icon": "./assets/app-icon.png"
    },
    "android": {
      "package": "com.example.wgclean",
      "googleServicesFile": "./google-services.json",
      "icon": "./assets/app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B0D"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "6f660f43-0f38-46b4-b07d-f96dbc929d54"
      }
    },
    "owner": "samrb-devs-team"
  }
}
